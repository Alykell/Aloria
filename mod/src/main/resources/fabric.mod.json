{
	"schemaVersion": 1,
	"id": "aloriahud",
	"version": "${version}",
	"name": "Aloria HUD",
	"description": "HUD personnalisable du launcher Aloria : modules déplaçables et réglables en direct depuis le menu Échap.",
	"authors": [
		"Alykell"
	],
	"contact": {
		"homepage": "https://github.com/Alykell/Aloria",
		"sources": "https://github.com/Alykell/Aloria"
	},
	"license": "MIT",
	"icon": "assets/aloriahud/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"fr.alykell.aloria.hud.AloriaHud"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"mixins": [
		{ "config": "aloriahud.mixins.json", "environment": "client" },
		"aloriahud.compat.mixins.json"
	]
}
